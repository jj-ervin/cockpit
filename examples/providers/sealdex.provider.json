{
  "schema_version": "cockpit-provider-v1",
  "id": "sealdex",
  "name": "Sealdex",
  "version": "0.2.0",
  "description": "Agent-assisted schema planning and zero-trust data entry for Sealdex's local-first operational registry.",
  "transport": { "kind": "stdio-json", "protocol": "cockpit-provider-v1" },
  "commands": [
    {
      "id": "sealdex.schema.propose",
      "title": "Propose a schema change",
      "action": "schema.propose",
      "mutation": false,
      "placements": ["view"]
    },
    {
      "id": "sealdex.schema.apply",
      "title": "Apply a proposed schema change",
      "action": "schema.apply",
      "mutation": true,
      "requires_confirmation": true,
      "placements": ["view"]
    },
    {
      "id": "sealdex.entry.tables",
      "title": "List writable tables",
      "action": "entry.tables",
      "mutation": false,
      "placements": ["view"]
    },
    {
      "id": "sealdex.entry.add",
      "title": "Add a row",
      "action": "entry.add",
      "mutation": true,
      "requires_confirmation": true,
      "placements": ["view"]
    },
    {
      "id": "sealdex.entry.import",
      "title": "Import rows from CSV",
      "action": "entry.import",
      "mutation": true,
      "requires_confirmation": true,
      "placements": ["view"]
    }
  ],
  "views": [
    { "id": "sealdex.workspace", "title": "Sealdex", "kind": "workspace", "placement": "primary" }
  ],
  "capabilities": ["read", "write"],
  "permissions": []
}
