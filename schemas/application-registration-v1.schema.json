{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cockpit.dev/schemas/application-registration-v1.schema.json",
  "title": "Application Registration Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "tabs"],
  "properties": {
    "schema_version": { "const": "application-registration-v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "icon": { "type": "string" },
    "tabs": {
      "type": "array",
      "items": { "$ref": "#/$defs/tab" }
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    },
    "settings": {
      "type": "array",
      "items": { "$ref": "#/$defs/setting" }
    }
  },
  "$defs": {
    "tab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "panel"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "icon": { "type": "string" },
        "panel": { "type": "string", "minLength": 1 },
        "order": { "type": "integer" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "action": { "type": "string", "minLength": 1 }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "type": { "enum": ["string", "boolean", "number", "select"] },
        "default": {}
      }
    }
  }
}
