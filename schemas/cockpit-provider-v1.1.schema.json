{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cockpit.dev/schemas/cockpit-provider-v1.1.schema.json",
  "title": "Cockpit Provider Manifest v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "transport", "commands", "views", "capabilities"],
  "properties": {
    "schema_version": { "const": "cockpit-provider-v1.1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "maxLength": 500 },
    "transport": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": { "kind": { "const": "stdio-json" }, "protocol": { "const": "cockpit-provider-v1.1" } }
    },
    "commands": { "type": "array", "items": { "$ref": "#/$defs/command" }, "uniqueItems": true },
    "views": { "type": "array", "items": { "$ref": "#/$defs/view" }, "uniqueItems": true },
    "capabilities": { "type": "array", "items": { "enum": ["read", "write", "execute", "filesystem", "network", "secrets", "notifications", "evidence"] }, "uniqueItems": true },
    "permissions": { "type": "array", "items": { "$ref": "#/$defs/permission" }, "default": [] },
    "appearance": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "icon": { "type": "string", "pattern": "^asset:[a-zA-Z0-9._/-]+$" },
        "accent_token": { "type": "string", "pattern": "^provider\\.[a-z][a-z0-9.-]+$" },
        "preferred_view": { "type": "string" }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "action", "mutation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
        "title": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "mutation": { "type": "boolean" },
        "requires_confirmation": { "type": "boolean", "default": false },
        "placements": { "type": "array", "items": { "enum": ["command-palette", "toolbar", "context-menu", "view"] }, "uniqueItems": true },
        "input": { "$ref": "#/$defs/input" }
      },
      "allOf": [{ "if": { "properties": { "mutation": { "const": true } }, "required": ["mutation"] }, "then": { "required": ["requires_confirmation"], "properties": { "requires_confirmation": { "const": true } } } }]
    },
    "input": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": {
        "mode": { "enum": ["none", "object"] },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" }, "uniqueItems": true }
      },
      "allOf": [{ "if": { "properties": { "mode": { "const": "object" } }, "required": ["mode"] }, "then": { "required": ["fields"] } }, { "if": { "properties": { "mode": { "const": "none" } }, "required": ["mode"] }, "then": { "properties": { "fields": { "maxItems": 0 } } } }]
    },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "label", "description", "type", "required"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "type": { "enum": ["string", "number", "integer", "boolean", "enum"] },
        "required": { "type": "boolean" },
        "default": {},
        "enum": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "secret": { "type": "boolean", "default": false }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] }, "then": { "required": ["enum"] } },
        { "if": { "properties": { "type": { "enum": ["string", "number", "integer", "boolean"] } }, "required": ["type"] }, "then": { "not": { "required": ["enum"] } } }
      ]
    },
    "view": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["panel", "workspace", "inspector", "settings", "custom-canvas"] },
        "placement": { "enum": ["primary", "sidebar", "bottom", "right", "settings"] }
      }
    },
    "permission": {
      "type": "object", "additionalProperties": false, "required": ["id", "reason"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 }, "required": { "type": "boolean", "default": true } }
    }
  }
}