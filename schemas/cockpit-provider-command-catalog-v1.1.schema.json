{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cockpit.dev/schemas/cockpit-provider-command-catalog-v1.1.schema.json",
  "title": "Cockpit Provider Command Catalog v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "providers"],
  "properties": {
    "schema_version": { "const": "cockpit-provider-command-catalog-v1.1" },
    "providers": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "version", "commands"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "appearance": { "type": "object" },
          "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
          "views": { "type": "array" },
          "capabilities": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "action", "mutation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "mutation": { "type": "boolean" },
        "requires_confirmation": { "type": "boolean" },
        "placements": { "type": "array", "items": { "type": "string" } },
        "input": { "$ref": "#/$defs/input" }
      }
    },
    "input": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": {
        "mode": { "enum": ["none", "object"] },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
      },
      "allOf": [{ "if": { "properties": { "mode": { "const": "object" } }, "required": ["mode"] }, "then": { "required": ["fields"] } }, { "if": { "properties": { "mode": { "const": "none" } }, "required": ["mode"] }, "then": { "properties": { "fields": { "maxItems": 0 } } } }]
    },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "label", "description", "type", "required"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "type": { "enum": ["string", "number", "integer", "boolean", "enum"] },
        "required": { "type": "boolean" },
        "default": {},
        "enum": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "secret": { "type": "boolean", "default": false }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] }, "then": { "required": ["enum"] } },
        { "if": { "properties": { "type": { "enum": ["string", "number", "integer", "boolean"] } }, "required": ["type"] }, "then": { "not": { "required": ["enum"] } } }
      ]
    }
  }
}