{
  "name": "eco-dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.windows": "bash"
      },
      "extensions": [
        "ms-vscode.powershell",
        "ms-azuretools.vscode-docker",
        "ms-vscode.remote-containers"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode"
}
