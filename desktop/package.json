{
  "name": "cockpit-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Electron desktop host for Cockpit's standalone web shell.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs",
    "build:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ospreyshl.cockpit",
    "productName": "Cockpit",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../host-web",
        "to": "host-web",
        "filter": [
          "**/*",
          "!tests/**"
        ]
      },
      {
        "from": "../web",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../dist/cockpit-bridge",
        "to": "bridge"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "express": "^4.22.2"
  }
}
