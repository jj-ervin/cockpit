{
  "name": "cockpit-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Electron desktop runtime packaged as a Marlin-managed Cockpit Core payload.",
  "main": "main.cjs",
  "scripts": {
    "icons:verify": "node scripts/verify-icon-pack.cjs",
    "start": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs",
    "build:win": "npm run build:win:x64",
    "build:win:x64": "npm run icons:verify && electron-builder --win dir --x64 --config.directories.output=release/x64",
    "build:win:arm64": "npm run icons:verify && electron-builder --win dir --arm64 --config.directories.output=release/arm64"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ospreyshl.cockpit",
    "productName": "Cockpit",
    "directories": {
      "output": "release"
    },
    "compression": "normal",
    "files": [
      "main.cjs",
      "preload.cjs",
      "assets/cockpit-icon-pack/cockpit.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../host-web",
        "to": "host-web",
        "filter": [
          "**/*",
          "!tests/**",
          "!node_modules/**",
          "!package-lock.json"
        ]
      },
      {
        "from": "../web",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../dist/cockpit-bridge",
        "to": "bridge"
      }
    ],
    "win": {
      "icon": "assets/cockpit-icon-pack/cockpit.ico",
      "target": ["dir"]
    }
  },
  "dependencies": {
    "express": "^4.22.2"
  }
}
